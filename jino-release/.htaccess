Options -Indexes
DirectoryIndex index.html
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^api/catalog$ elstar-local-api.php?route=catalog [QSA,L]
RewriteRule ^api/catalog/file/(isonex|lightstar)/([a-f0-9]{64})/((catalog|details-[0-9]{1,3})\.json)$ elstar-local-api.php?route=file&supplier=$1&revision=$2&file=$3 [QSA,L]
RewriteRule ^api/catalog/update$ elstar-local-api.php?route=update [QSA,L]
RewriteRule ^api/request-ticket$ elstar-local-api.php?route=ticket [QSA,L]
RewriteRule ^(privacy|consent)/?$ index.html [L]
</IfModule>
